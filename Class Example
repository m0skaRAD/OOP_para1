#include <iostream>
using namespace std;
class Point {
private:
	int _x;
	int _y;
	int _z;
public:
	Point(int x, int y, int z) {
		Point::_x = x;
		Point::_y = y;
		Point::_z = z;
	}
	void Print() {
		cout << "Coordinates = {" << _x << ", " << _y << ", " << _z << "}" << endl;
	}
	void ChangeX(int IX) {
		_x = IX;
	}
	void ChangeY(int IZ) {
		_y = IZ;
	}
	void ChangeZ(int IZ) {
		_z = IZ;
	}
};

int main()
{
	Point point(2,5,6);
	point.Print();
	point.ChangeX(7);
	point.Print();
}








#include <iostream>
using namespace std;

const int MaxLength = 28;
const int CountOfMarks = 5;

class Student {
private: //Реалізація (Те, до чого не має доступ користувач)
	//Характеристики - поля
	//int age;
	//int height;
	//int weight;
	char name[MaxLength];
	int marks[CountOfMarks];
	
public: //Інтерфейс
	//Конструктор з параметрами
	Student(const char* name, const int* marks) {
