class NumberList {
private:
    vector<int> number;
public:
    NumberList(initializer_list<int> list) {
        for (int x : list) {
            number.push_back(x);
        }
    }
    void Print() {
        for (int x : number) {
            cout << x << " ";
        }
    }
};



